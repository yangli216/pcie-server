# PCIE Server three-node production baseline.
# Do not deploy this file until every <...> placeholder has been replaced by
# controlled configuration or secret injection. Only FB_NODE_ID differs by node.

SPRING_PROFILES_ACTIVE=<deployment-profile>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=<jdbc-driver-class>
SPRING_DATASOURCE_URL=<jdbc-url>
SPRING_DATASOURCE_USERNAME=<secret-database-user>
SPRING_DATASOURCE_PASSWORD=<secret-database-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=3000

FB_AES_KEY=<same-cluster-secret>
FB_CLUSTER_ENABLED=true
FB_CLUSTER_ID=<cluster-id>
FB_NODE_ID=<pcie-01-or-pcie-02-or-pcie-03>
FB_CLUSTER_SHARED_STORAGE_REQUIRED=true
FB_CLUSTER_STORAGE_CHALLENGE_TTL_SECONDS=60
FB_RELEASE_WRITER_NODE_ID=pcie-01
FB_CLUSTER_MARKER_FILE=.pcie-cluster-id
FB_RELEASE_STORAGE_DIR=/srv/pcie-shared/releases
FB_AUDIT_SPEECH_FILE_DIR=/srv/pcie-shared/speech-audit
FB_RELEASE_PUBLIC_BASE_URL=https://<pcie-lb-domain>

FB_MANAGEMENT_ADDRESS=127.0.0.1
FB_MANAGEMENT_PORT=8081
FB_SHUTDOWN_TIMEOUT=150s

# Canonical Spring environment names intentionally override profile literals.
FLOATING_BALL_AI_CONNECT_TIMEOUT_MS=5000
FLOATING_BALL_AI_READ_TIMEOUT_MS=120000

FB_TOMCAT_MAX_THREADS=200
FB_TOMCAT_MIN_SPARE_THREADS=20
FB_TOMCAT_ACCEPT_COUNT=50

FB_AI_BLOCKING_POOL_SIZE=96
FB_AI_BLOCKING_QUEUE_CAPACITY=8
FB_AI_BLOCKING_TIMEOUT_MS=130000
FB_AI_SPEECH_POOL_SIZE=8
FB_AI_SPEECH_QUEUE_CAPACITY=4
FB_AI_REVIEWER_POOL_SIZE=16
FB_AI_REVIEWER_QUEUE_CAPACITY=4
FB_KNOWLEDGE_POOL_SIZE=16
FB_KNOWLEDGE_QUEUE_CAPACITY=4
FB_KNOWLEDGE_TIMEOUT_MS=30000

FB_AI_STREAM_CORE_POOL_SIZE=24
FB_AI_STREAM_MAX_POOL_SIZE=24
FB_AI_STREAM_QUEUE_CAPACITY=4
FB_AI_STREAM_TIMEOUT_MS=130000

FB_AI_REALTIME_MAX_ACTIVE_SESSIONS=64
FB_AI_REALTIME_MAX_BUFFERED_AUDIO_BYTES=2097152
FB_AI_REALTIME_HANDSHAKE_TIMEOUT_MS=10000

FB_AI_HTTP_MAX_TOTAL=224
FB_AI_HTTP_MAX_PER_ROUTE=192
FB_AI_HTTP_CONNECTION_REQUEST_TIMEOUT_MS=500
FB_AI_HTTP_VALIDATE_AFTER_INACTIVITY_MS=5000
FB_AI_HTTP_IDLE_EVICT_SECONDS=30

FB_OUTBOUND_RATE_LIMIT_PER_MINUTE=120
FB_OUTBOUND_ALLOW_ALL_HOSTS=false
FB_OUTBOUND_ALLOWED_HOSTS=<comma-separated-cloud-hosts>
FB_OUTBOUND_ALLOW_PRIVATE_NETWORK=false
FB_OUTBOUND_ALLOW_INSECURE_HTTP=false
FB_OUTBOUND_ALLOW_PROXY_FAKE_IP=false

# Replace from measured pressure-test results. The placeholder intentionally
# prevents this example from being used as a production-ready service file.
PCIE_JAVA_OPTS=<measured-Xms-Xmx-Xss-and-observability-options>
