map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream pcie_server_cluster {
    zone pcie_server_cluster 64k;
    least_conn;
    server 10.10.20.11:8080 max_fails=2 fail_timeout=10s;
    server 10.10.20.12:8080 max_fails=2 fail_timeout=10s;
    server 10.10.20.13:8080 max_fails=2 fail_timeout=10s;
    keepalive 64;
}

upstream pcie_release_writer {
    zone pcie_release_writer 16k;
    server 10.10.20.11:8080 max_fails=2 fail_timeout=10s;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    server_name pcie.example.internal;

    # TLS certificate directives are supplied by the deployment environment.

    # 该静态示例依赖外部健康代理按 readiness 摘挂 upstream 节点；生产也可
    # 使用支持主动健康检查的负载均衡产品。

    location ^~ /admin/api/releases {
        client_max_body_size 2048m;
        proxy_pass http://pcie_release_writer;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # WebSocket 握手的 query 包含 token、nonce 和签名，禁止写入 access log。
    location = /v1/ai/speech/realtime/ws {
        access_log off;
        proxy_pass http://pcie_server_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 3s;
    }

    location / {
        proxy_pass http://pcie_server_cluster;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # 设备签名 nonce 只能使用一次。由客户端使用新 nonce 重试，LB 不得
        # 将同一个已签名 POST 自动重放到其他节点。
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        proxy_connect_timeout 3s;
    }
}
