worker_processes auto;

events {
    worker_connections 1024;
}

http {
merge_slashes off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream pcie_server {
    server 127.0.0.1:8080;
    keepalive 64;
}

server {
    # 本模板使用内网 HTTP 便于语法验证。正式环境需要 HTTPS 时，应由现场
    # 使用受控证书调整 listen，并保持客户端访问地址与发布下载地址一致。
    listen 80;
    server_name pcie.example.invalid;

    # 发布上传可能较大，单独放宽请求体与代理超时。
    location ^~ /admin/api/releases {
        client_max_body_size 2048m;
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # query 中包含 token、nonce 和签名，不写入访问日志。
    location = /v1/ai/speech/realtime/ws {
        access_log off;
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 同一路径同时承载普通响应和 SSE；关闭缓冲避免流式内容滞留。
    location = /v1/ai/chat {
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }

    # 批量语音可能包含较大录音，并且上游识别时间长于普通请求。
    location = /v1/ai/speech/transcribe {
        client_max_body_size 2048m;
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location = /v1/ai/speech/realtime {
        client_max_body_size 2048m;
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 四条 canonical AI 路径以外的变体一律拒绝，不能回落到普通业务 upstream。
    # 关闭访问日志，避免伪造的 WebSocket 变体把 token、nonce、签名 query 写入日志。
    location ~ "^/+v1/+ai(?:/+|;|$)" {
        access_log off;
        return 404;
    }

    location / {
        proxy_pass http://pcie_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        # 已签名请求中的 nonce 只能使用一次，代理不得自动重放请求。
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
}
