# PCIE Server 单实例生产环境模板。
# 复制到受控配置目录后，必须替换全部 <...> 占位符；不要把真实凭据回填到仓库。
# SPRING_PROFILES_ACTIVE 必须选择已经针对现场数据库完成审核的生产 profile，
# 禁止使用 development、test 或其他开发/测试 profile。

SPRING_PROFILES_ACTIVE=<reviewed-production-profile>
SERVER_ADDRESS=<127.0.0.1-or-private-service-address>
SERVER_PORT=8080

SPRING_DATASOURCE_DRIVER_CLASS_NAME=<jdbc-driver-class>
SPRING_DATASOURCE_URL=<jdbc-url>
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=<measured-pool-size>
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=<measured-minimum-idle>
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=<measured-connection-timeout-ms>
MYBATIS_PLUS_DB_TYPE=<oracle-or-opengauss-or-dm>

FB_AES_KEY=<controlled-application-secret>
FB_ADMIN_BOOTSTRAP_RESET_ENABLED=false
FB_ADMIN_ORIGIN=<admin-origin>

FB_LOG_PATH=/var/log/pcie-server
FB_RELEASE_STORAGE_DIR=/var/lib/pcie-server/releases
FB_AUDIT_SPEECH_FILE_DIR=/var/lib/pcie-server/speech-audit
FB_RELEASE_PUBLIC_BASE_URL=<client-visible-base-url>
FB_RELEASE_MAX_FILE_SIZE=2048MB
FB_RELEASE_MAX_REQUEST_SIZE=2048MB

FB_MANAGEMENT_ADDRESS=127.0.0.1
FB_MANAGEMENT_PORT=8081
FB_SHUTDOWN_TIMEOUT=150s

# 生产默认拒绝任意出站和不安全协议，只放行现场实际使用的云服务域名。
FB_OUTBOUND_ALLOW_ALL_HOSTS=false
FB_OUTBOUND_ALLOWED_HOSTS=<comma-separated-approved-hosts>
FB_OUTBOUND_ALLOW_PRIVATE_NETWORK=false
FB_OUTBOUND_ALLOW_INSECURE_HTTP=false
FB_OUTBOUND_ALLOW_PROXY_FAKE_IP=false
FB_AI_PROXY_ENABLED=false

# 必须根据现场主机与压测结果设置 Xms、Xmx、Xss 和所需观测参数。
PCIE_JAVA_OPTS=<measured-java-options>
