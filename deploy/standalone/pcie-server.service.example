[Unit]
Description=PCIE Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pcie
Group=pcie
WorkingDirectory=/opt/pcie-server/app
Environment="PCIE_JAVA_OPTS="
EnvironmentFile=/etc/pcie-server/pcie-server.env
StateDirectory=pcie-server
StateDirectoryMode=0750
LogsDirectory=pcie-server
LogsDirectoryMode=0750
ExecStartPre=/usr/bin/mkdir -p /var/lib/pcie-server/releases /var/lib/pcie-server/speech-audit
ExecStart=/usr/bin/java $PCIE_JAVA_OPTS -jar /opt/pcie-server/app/pcie-server.jar
SuccessExitStatus=143
KillSignal=SIGTERM
TimeoutStartSec=180
TimeoutStopSec=180
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

# MemoryMax 与 LimitNOFILE 必须在现场 systemd drop-in 中按压测结果设置，
# 不能复制其他环境的固定值。

[Install]
WantedBy=multi-user.target
