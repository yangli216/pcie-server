# PCIE Server Docker 双节点测试环境变量。
# 仅用于本机隔离测试，不得填写或复制现场数据库、应用密钥和真实发布配置。

OPENGAUSS_IMAGE=enmotech/opengauss-lite:5.0.3
NGINX_IMAGE=nginx:1.27-alpine
PCIE_SERVER_IMAGE=pcie-server:docker-multi-node-local

PCIE_DB_NAME=pcie_cluster_test
PCIE_DB_USERNAME=rbmh_ai
PCIE_DB_PASSWORD=
PCIE_DB_POOL_MAX_SIZE=10
PCIE_DB_POOL_MIN_IDLE=2
PCIE_DB_CONNECTION_TIMEOUT_MS=10000

PCIE_SHARED_STORAGE_ID=pcie-docker-shared-v1
PCIE_CONTAINER_UID=10001
PCIE_CONTAINER_GID=10001
PCIE_AES_KEY=
PCIE_NONCE_DEEP_PROBE_INTERVAL_MS=300000

PCIE_TOMCAT_MAX_THREADS=80
PCIE_TOMCAT_MIN_SPARE_THREADS=8
PCIE_TOMCAT_ACCEPT_COUNT=32
PCIE_AI_BLOCKING_POOL_SIZE=16
PCIE_AI_BLOCKING_QUEUE_CAPACITY=4
PCIE_AI_HTTP_MAX_TOTAL=32
PCIE_AI_HTTP_MAX_PER_ROUTE=24
PCIE_AI_STREAM_POOL_SIZE=8
PCIE_AI_STREAM_QUEUE_CAPACITY=4
PCIE_AI_REALTIME_MAX_ACTIVE_SESSIONS=16
PCIE_JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -Xss512k
