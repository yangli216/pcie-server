# PCIE Server 手工多节点生产环境模板。
# 每台节点单独复制到受控配置目录并替换全部 <...>；不要提交真实凭据。
# 除 FB_NODE_ID 与 SERVER_ADDRESS 外，所有节点的集群关键配置必须一致。

SPRING_PROFILES_ACTIVE=<reviewed-production-profile>
SERVER_ADDRESS=<private-service-address>
SERVER_PORT=8080

# ai-scale-out 明确启用共享数据库 nonce 和共享 POSIX 存储门禁。
FB_DEPLOYMENT_MODE=ai-scale-out
FB_NODE_ID=<unique-node-id>
FB_NONCE_STORE=database
FB_NONCE_DEEP_PROBE_INTERVAL_MS=300000
FB_STORAGE_MODE=shared-posix
# 必须与 releases/.pcie-storage-id 和 speech-audit/.pcie-storage-id 的内容精确一致。
FB_SHARED_STORAGE_ID=<same-storage-id-on-every-node>

FB_DB_DRIVER=<jdbc-driver-class>
FB_DB_URL=<shared-jdbc-url>
FB_DB_USERNAME=<database-user>
FB_DB_PASSWORD=<database-password>
# 使用 Spring 标准环境变量，确保能覆盖各数据库 profile 中可能存在的 Hikari 默认值。
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=<measured-per-node-pool-size>
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=<measured-per-node-minimum-idle>
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=<measured-connection-timeout-ms>
FB_DB_TYPE=<oracle-or-opengauss-or-dm>

FB_AES_KEY=<same-controlled-application-secret-on-every-node>
FB_ADMIN_BOOTSTRAP_RESET_ENABLED=false
FB_ADMIN_ORIGIN=<admin-origin>

FB_LOG_PATH=/var/log/pcie-server
FB_RELEASE_STORAGE_DIR=/mnt/pcie-shared/releases
FB_AUDIT_SPEECH_FILE_DIR=/mnt/pcie-shared/speech-audit
FB_RELEASE_PUBLIC_BASE_URL=<client-visible-nginx-base-url>
FB_RELEASE_MAX_FILE_SIZE=2048MB
FB_RELEASE_MAX_REQUEST_SIZE=2048MB

# 管理端口必须保持本机可见，不加入 Nginx upstream。
FB_MANAGEMENT_ADDRESS=127.0.0.1
FB_MANAGEMENT_PORT=8081
FB_SHUTDOWN_TIMEOUT=150s

# 生产默认拒绝任意出站和不安全协议，只放行现场实际使用的云服务域名。
FB_OUTBOUND_ALLOW_ALL_HOSTS=false
FB_OUTBOUND_ALLOWED_HOSTS=<comma-separated-approved-hosts>
FB_OUTBOUND_ALLOW_PRIVATE_NETWORK=false
FB_OUTBOUND_ALLOW_INSECURE_HTTP=false
FB_OUTBOUND_ALLOW_PROXY_FAKE_IP=false
FB_AI_PROXY_ENABLED=false

# 每节点容量参数必须来自单节点压测；数据库总连接数需按节点数重新核算。
FB_TOMCAT_MAX_THREADS=<measured-per-node-max-threads>
FB_TOMCAT_MIN_SPARE_THREADS=<measured-per-node-min-spare-threads>
FB_TOMCAT_ACCEPT_COUNT=<measured-per-node-accept-count>
FB_AI_BLOCKING_POOL_SIZE=<measured-per-node-ai-pool-size>
FB_AI_BLOCKING_QUEUE_CAPACITY=<measured-short-queue-capacity>
FB_AI_HTTP_MAX_TOTAL=<measured-per-node-http-max-total>
FB_AI_HTTP_MAX_PER_ROUTE=<measured-per-node-http-max-per-route>
FB_AI_STREAM_CORE_POOL_SIZE=<measured-per-node-stream-pool-size>
FB_AI_STREAM_MAX_POOL_SIZE=<measured-per-node-stream-pool-size>
FB_AI_STREAM_QUEUE_CAPACITY=<measured-short-stream-queue-capacity>
FB_AI_REALTIME_MAX_ACTIVE_SESSIONS=<measured-per-node-realtime-sessions>
FB_AI_REALTIME_TASK_START_TIMEOUT_MS=10000
FB_AI_REALTIME_IDLE_TIMEOUT_MS=60000
FB_AI_REALTIME_FINAL_TIMEOUT_MS=15000

# 必须根据现场主机与压测结果设置 Xms、Xmx、Xss 和所需观测参数。
PCIE_JAVA_OPTS=<measured-java-options>
